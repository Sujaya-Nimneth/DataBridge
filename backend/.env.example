# DataBridge Backend Environment Configuration
# Copy this file to .env and update values for your environment

# Application
APP_NAME=DataBridge
APP_VERSION=1.0.0
DEBUG=true

# Database (Application PostgreSQL)
DATABASE_URL=postgresql+asyncpg://databridge:databridge@localhost:5432/databridge
DATABASE_SYNC_URL=postgresql+psycopg2://databridge:databridge@localhost:5432/databridge

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-in-production-minimum-32-characters-long

# Encryption Key (must be a valid Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=RGF0YUJyaWRnZS1leGFtcGxlLWtleS1kb250LXVzZSE=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Transfer Settings
TRANSFER_BATCH_SIZE=1000
TRANSFER_MAX_PREVIEW_ROWS=100
